{
  "name": "Homebrew-Translator",
  "description": "Translator extension made using tesseractor library com JS. Translations are supposed to be make using ollama models for local use.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html","default_icons": {"16":"./assets/icons/16.png", "32":"./assets/icons/32.png"}
  },
  "icons": {"16":"./assets/icons/16.png", "32":"./assets/icons/32.png", "48":"./assets/icons/48.png", "128":"./assets/icons/128.png"},
  "background": {"service_worker": "./dist/background.bundle.js"},
  "permissions": ["management", "storage"],
  "host_permissions": ["http://127.0.0.1:11434/*", "http://localhost:11434/*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["./dist/content.bundle.js"]
    }
  ]
}