{
  "name": "Homebrew-Translator",
  "description": "Translator extension made using tesseractor library com JS. Translations are supposed to be make using ollama models for local use.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "hello.html","default_icons": {"16":"icons/16.png", "32":"icons/32.png"}
  },
  "icons": {"16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png"},
  "background": {"service_worker": "./scripts/background.js"},
  "permissions": ["management", "storage"],
  "content_scripts": [{"js": ["./dist/content.bundle.js"]}]
}